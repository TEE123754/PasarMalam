  "components": {
    "schemas": {
      "Actor": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "ms"
            ],
            "title": "Locale"
          },
          "verified": {
            "type": "boolean",
            "title": "Verified"
          },
          "roles": {
            "items": {
              "type": "string",
              "enum": [
                "customer",
                "vendor",
                "admin",
                "partner",
                "organiser"
              ]
            },
            "type": "array",
            "title": "Roles"
          }
        },
        "type": "object",
        "required": [
          "id",
          "display_name",
          "locale",
          "verified",
          "roles"
        ],
        "title": "Actor"
      },
      "BatchInput": {
        "properties": {
          "food_item_id": {
            "type": "string",
            "format": "uuid",
            "title": "Food Item Id"
          },
          "prepared_at": {
            "type": "string",
            "format": "date-time",
            "title": "Prepared At"
          },
          "quantity": {
            "type": "integer",
            "maximum": 100000.0,
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          },
          "handling": {
            "additionalProperties": true,
            "type": "object",
            "title": "Handling"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "food_item_id",
          "prepared_at",
          "quantity",
          "request_id"
        ],
        "title": "BatchInput"
      },
      "CheckInInput": {
        "properties": {
          "market_id": {
            "type": "string",
            "format": "uuid",
            "title": "Market Id"
          }
        },
        "type": "object",
        "required": [
          "market_id"
        ],
        "title": "CheckInInput"
      },
      "Cleanup": {
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 150,
            "pattern": "^[0-9a-f-]{36}/[0-9a-f-]{36}/[0-9a-f-]{36}\\.jpg$",
            "title": "Key"
          }
        },
        "type": "object",
        "required": [
          "key"
        ],
        "title": "Cleanup"
      },
      "ComplaintInput": {
        "properties": {
          "stall_id": {
            "type": "string",
            "format": "uuid",
            "title": "Stall Id"
          },
          "body": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Body"
          },
          "evidence_keys": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Evidence Keys"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "stall_id",
          "body",
          "request_id"
        ],
        "title": "ComplaintInput"
      },
      "DietaryClaim": {
        "properties": {
          "foodItemId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fooditemid"
          },
          "status": {
            "type": "string",
            "enum": [
              "declared",
              "certified",
              "non-halal",
              "not-declared"
            ],
            "title": "Status"
          },
          "expiresAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expiresat"
          },
          "reviewedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewedat"
          },
          "evidence": {
            "type": "boolean",
            "title": "Evidence",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "DietaryClaim"
      },
      "DiscoverySnapshot": {
        "properties": {
          "markets": {
            "items": {
              "$ref": "#/components/schemas/Market"
