          {
            "name": "north",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 90,
              "minimum": -90,
              "default": 90,
              "title": "North"
            }
          },
          {
            "name": "east",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 180,
              "minimum": -180,
              "default": 180,
              "title": "East"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
