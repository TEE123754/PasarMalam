  "components": {
    "schemas": {
      "Actor": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "ms"
            ],
            "title": "Locale"
          },
          "verified": {
            "type": "boolean",
            "title": "Verified"
          },
          "roles": {
            "items": {
              "type": "string",
              "enum": [
                "customer",
                "vendor",
                "admin",
                "partner",
                "organiser"
              ]
            },
            "type": "array",
            "title": "Roles"
          }
        },
        "type": "object",
        "required": [
          "id",
          "display_name",
          "locale",
          "verified",
          "roles"
        ],
        "title": "Actor"
      },
      "BatchInput": {
        "properties": {
          "food_item_id": {
            "type": "string",
            "format": "uuid",
            "title": "Food Item Id"
          },
          "prepared_at": {
            "type": "string",
            "format": "date-time",
            "title": "Prepared At"
          },
          "quantity": {
            "type": "integer",
            "maximum": 100000.0,
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          },
          "handling": {
            "additionalProperties": true,
            "type": "object",
            "title": "Handling"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "food_item_id",
          "prepared_at",
          "quantity",
          "request_id"
        ],
        "title": "BatchInput"
      },
      "ComplaintInput": {
        "properties": {
          "stall_id": {
            "type": "string",
            "format": "uuid",
            "title": "Stall Id"
          },
          "body": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Body"
          },
          "evidence_keys": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Evidence Keys"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "stall_id",
          "body",
          "request_id"
        ],
        "title": "ComplaintInput"
      },
      "DiscoverySnapshot": {
        "properties": {
          "markets": {
            "items": {
              "$ref": "#/components/schemas/Market"
            },
            "type": "array",
            "title": "Markets"
          },
          "stalls": {
            "items": {
              "$ref": "#/components/schemas/Stall"
            },
            "type": "array",
            "title": "Stalls"
          },
          "offers": {
            "items": {
              "$ref": "#/components/schemas/Offer"
            },
            "type": "array",
            "title": "Offers"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Updatedat"
          }
        },
        "type": "object",
        "required": [
          "markets",
          "stalls",
          "offers",
          "updatedAt"
        ],
        "title": "DiscoverySnapshot"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "timestamp"
        ],
        "title": "HealthResponse"
      },
      "InventoryInput": {
        "properties": {
          "delta": {
            "type": "integer",
            "exclusiveMaximum": 0.0,
            "minimum": -100000.0,
            "title": "Delta"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "delta",
          "request_id"
        ],
        "title": "InventoryInput"
      },
      "Market": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "area": {
            "type": "string",
            "title": "Area"
          },
          "type": {
            "type": "string",
            "enum": [
              "night",
              "day"
            ],
            "title": "Type"
          },
          "hours": {
            "type": "string",
            "title": "Hours"
          },
          "days": {
            "type": "string",
            "title": "Days"
          },
          "cover": {
            "type": "string",
            "title": "Cover"
          },
          "stallCount": {
            "type": "integer",
            "title": "Stallcount"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "upcoming",
              "closed"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "area",
          "type",
          "hours",
          "days",
          "cover",
          "stallCount",
          "status"
        ],
        "title": "Market"
      },
      "ModerationInput": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "triaged",
              "dismissed",
              "escalated"
            ],
            "title": "Status"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "status",
          "request_id"
        ],
        "title": "ModerationInput"
      },
      "Offer": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "stallId": {
            "type": "string",
            "title": "Stallid"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "priceSen": {
            "type": "integer",
            "title": "Pricesen"
          },
          "originalPriceSen": {
            "type": "integer",
            "title": "Originalpricesen"
          },
          "endsAt": {
            "type": "string",
            "title": "Endsat"
          }
        },
        "type": "object",
        "required": [
          "id",
          "stallId",
          "title",
          "priceSen",
          "originalPriceSen",
          "endsAt"
        ],
        "title": "Offer"
      },
      "PromotionInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Title"
          },
          "price_sen": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 0.0,
            "title": "Price Sen"
          },
          "quantity": {
            "type": "integer",
            "maximum": 100000.0,
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time",
            "title": "Ends At"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "title",
          "price_sen",
          "quantity",
          "ends_at",
          "request_id"
        ],
        "title": "PromotionInput"
      },
      "PublicConfigResponse": {
        "properties": {
          "api_version": {
            "type": "string",
            "title": "Api Version"
          },
          "supported_locales": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Supported Locales"
          },
          "business_integration_mode": {
            "type": "string",
            "const": "simulated",
            "title": "Business Integration Mode"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Capabilities"
          }
        },
        "type": "object",
        "required": [
          "api_version",
          "supported_locales",
          "business_integration_mode",
          "capabilities"
        ],
        "title": "PublicConfigResponse"
      },
      "ReviewInput": {
        "properties": {
          "stall_id": {
            "type": "string",
            "format": "uuid",
            "title": "Stall Id"
          },
          "rating": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Rating"
          },
          "body": {
            "type": "string",
            "maxLength": 1500,
            "minLength": 1,
            "title": "Body"
          }
        },
        "type": "object",
        "required": [
          "stall_id",
          "rating",
          "body"
        ],
        "title": "ReviewInput"
      },
      "Stall": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "marketId": {
            "type": "string",
            "title": "Marketid"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "specialty": {
            "type": "string",
            "title": "Specialty"
          },
          "priceSen": {
            "type": "integer",
            "title": "Pricesen"
          },
          "rating": {
            "type": "number",
            "title": "Rating"
          },
          "reviews": {
            "type": "integer",
            "title": "Reviews"
          },
          "image": {
            "type": "string",
            "title": "Image"
          },
          "halal": {
            "type": "string",
            "enum": [
              "declared",
              "non-halal",
              "not-declared"
            ],
            "title": "Halal"
          },
          "open": {
            "type": "boolean",
            "title": "Open"
          }
        },
        "type": "object",
        "required": [
          "id",
          "marketId",
          "name",
          "category",
          "specialty",
          "priceSen",
          "rating",
          "reviews",
          "image",
          "halal",
          "open"
        ],
        "title": "Stall"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
