# Public mode: fixture or connected. Connected data/auth implementation begins in Phase 2.
VITE_APP_MODE=fixture
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
