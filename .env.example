# Browser configuration only; keep privileged operator values in apps/api/.env.
# Workspace is chosen by URL: /demo/* (fictional) or root (real).
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# API/operator examples are in apps/api/.env.example. No private key belongs here.
