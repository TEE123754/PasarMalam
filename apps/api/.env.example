APP_ENV=demo
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Only for local legacy-HS256 Auth. Hosted projects use their JWKS endpoint.
SUPABASE_JWT_SECRET=
INTEGRATION_MODE=simulated

# Operator-only seed/test settings. Never expose these to VITE variables.
SUPABASE_SECRET_KEY=
DATABASE_URL=
DEMO_PROJECT_REF=local
# Explicitly copy the migration-created environment_guard UUID from your disposable DB.
DEMO_DATABASE_ID=
DEMO_SEED_PASSWORD=

# Server only, >=32 random characters; install matching value with guarded media setup.
MEDIA_SIGNING_SECRET=
