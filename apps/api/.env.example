APP_ENV=demo
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Only for local legacy-HS256 Auth. Hosted projects use their JWKS endpoint.
SUPABASE_JWT_SECRET=
INTEGRATION_MODE=simulated
# Public signup stays disabled in this disposable schema. See docs/CP1_ACCEPTANCE.md.

# Operator-only seed/test settings. Never expose these to VITE variables.
SUPABASE_SECRET_KEY=
DATABASE_URL=
DEMO_PROJECT_REF=local
# Explicitly copy the migration-created environment_guard UUID from your disposable DB.
DEMO_DATABASE_ID=
DEMO_SEED_PASSWORD=

# Server only, >=32 random characters; install matching value with guarded media setup.
MEDIA_SIGNING_SECRET=

# Phase 5: separate scoped role credential; never use owner DATABASE_URL for dispatch.
WEATHER_MODE=fixture
AGENT_DISPATCH_SECRET=
AGENT_DATABASE_URL=
# Operator-only setup inputs; 32+ character separate password/secret.
AGENT_DATABASE_PASSWORD=
AGENT_DISPATCH_URL=

# Phase 6: optional free local llama.cpp only; no paid/cloud fallback.
LOCAL_LLM_URL=http://127.0.0.1:8080/v1/chat/completions
LOCAL_LLM_MODEL=pasar-voice

# Optional numeric-checked wording only; deterministic facts always remain authoritative.
ENABLE_ADVISORY_PARAPHRASE=false

# Phase 10: disabled unless an opted-in test device and disposable agent are configured.
PUSH_MODE=simulated
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# No real SMS/email provider or commercial integration keys are needed.

# Morpheus transcript extraction (private server only; no automatic retries).
EXTRACTION_PROVIDER=local
MORPHEUS_API_KEY=
MORPHEUS_BASE_URL=https://api.mor.org/api/v1
MORPHEUS_MODEL=qwen35-9b

# CP8 photo inference uses existing credits only after owner authorisation.
CP8_ALLOW_PAID_CREDITS=false
MORPHEUS_VISION_MODEL=gemma-4-31b
